rules_version = '2';

// 週末作り置き献立アプリ用のセキュリティルール
// Firebase コンソール → Firestore Database → ルール に貼り付けて「公開」してください
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // 自分がどの家族に入っているか
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 招待コード（コードを知っている人だけが読める）
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isMember(request.resource.data.householdId);
      allow delete: if signedIn() && isMember(resource.data.householdId);
    }

    match /households/{hid} {
      // 作成は自分だけがメンバーの状態で
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // メンバーは読み書きできる
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        // 招待コードでの参加：自分を members に追加するだけの更新
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastJoinCode'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.householdId == hid
        )
      );

      // 献立・レシピ・在庫・設定・買い物チェック
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
